[Unit]
Description=IoT Smart Thermostat Web Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/rebind_iot
Environment="FLASK_APP=rebind_iot"
ExecStart=/usr/bin/python3 -m flask run --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
